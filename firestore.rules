rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // กฎเดียว: ต้องล็อกอิน (มี Firebase Auth token) ก่อนจึงจะอ่านหรือเขียนได้
    // ครอบคลุมทุก collection/document ในฐานข้อมูล (users, mealLogs, mealLogs/*/nudges, foodCategories)
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}
