rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    match /mealLogs/{logId} {
      // อ่าน/แก้/ลบ ได้เฉพาะเจ้าของ mealLog (userId ตรงกับ uid ของคนที่ล็อกอิน)
      allow read: if request.auth != null
                  && resource.data.userId == request.auth.uid;
      allow create: if request.auth != null
                  && request.resource.data.userId == request.auth.uid;
      allow update, delete: if request.auth != null
                  && resource.data.userId == request.auth.uid;

      match /nudges/{nudgeId} {
        // nudge ไม่มี userId ของตัวเอง — เช็คย้อนไปที่ userId ของ mealLog แม่แทน
        allow read, write: if request.auth != null
                  && get(/databases/$(database)/documents/mealLogs/$(logId)).data.userId == request.auth.uid;
      }
    }

    // collection อื่น (users, foodCategories ฯลฯ): ต้องล็อกอินเท่านั้น ไม่มี ownership check
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}
